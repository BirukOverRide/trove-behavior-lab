# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get a key: https://console.x.ai
# Then restart: node ./server.js

XAI_API_KEY=xai-paste-your-key-here

# Listen (Oracle / production — use 0.0.0.0 so public IP works)
HOST=0.0.0.0
PORT=8000

# Auto-train (full fleet). Set AUTO_TRAIN=0 on tiny free VMs if CPU is tight.
# AUTO_TRAIN=0
AUTO_TRAIN_EPOCHS=12
AUTO_TRAIN_INTERVAL_MS=120000

# Optional:
# XAI_CHAT_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1
# PYTHON=python3
